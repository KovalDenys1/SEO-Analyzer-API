#!/bin/sh
# Run as root before each deploy: a git or file command run with sudo in /opt/seo-api leaves root-owned files that the ubuntu-run deploy cannot replace (30.10: stuck for three days).
set -eu
cd /opt/seo-api
chown -R ubuntu:ubuntu .git
chown ubuntu:ubuntu .
git -c safe.directory=/opt/seo-api ls-files -z | xargs -0 -r -n 200 sh -c '
for f; do
  if [ -e "$f" ] || [ -L "$f" ]; then chown -h ubuntu:ubuntu "$f" || true; fi
  d=$(dirname "$f")
  while [ "$d" != . ]; do chown -h ubuntu:ubuntu "$d" 2>/dev/null || true; d=$(dirname "$d"); done
done' _
